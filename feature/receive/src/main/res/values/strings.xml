<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Brand terms: the strings in this block name the party that holds users' funds ("mint" by default) or the notes
      it issues ("note"). A brand that uses other words overrides exactly these, per language, in
      brand/res/values*/strings.xml. All other strings are written without either word (developer options
      aside). See docs/WHITE_LABEL.md.
    -->
    <string name="receive_hint">Anyone can pay this address from any Lightning wallet. Payments arrive as notes in this wallet.</string>
    <string name="receive_no_mint">This wallet has no mint yet. Add one to receive.</string>
    <string name="receive_no_mint_action">Add mint</string>
    <string name="receive_no_home">This account has no home mint. Choose one of your mints to receive there.</string>
    <string name="receive_no_home_action">Choose home mint</string>
    <string name="receive_claim">Claim a note instead</string>
    <!-- Under the Lightning address, instead of receive_hint, when its mint didn't answer the last time. %1$s: the mint. -->
    <string name="receive_address_mint_silent_unnamed">Your mint isn\'t answering, so payments to this address can\'t arrive right now.</string>
    <!-- The home mint makes the invoice, and didn't answer. %1$s: the mint. -->
    <string name="receive_invoice_mint_silent_unnamed">Your mint isn\'t answering, so no invoice can be created right now. Try again later.</string>
    <!-- Receive picks this mint (%1$s), the home mint: see receive_on. -->
    <string name="receive_on_home">On %1$s, your home mint</string>
    <!-- The home mint in the Receive on list. %1$s: the address, or receive_on_invoice. -->
    <string name="receive_on_home_detail">Home mint · %1$s</string>
    <!-- As receive_address_key_changed and receive_invoice_key_changed, where the brand doesn't name mints. -->
    <string name="receive_address_key_changed_unnamed">The signing key of your mint doesn\'t match the one your wallet knows, so payments to this address wait there for now.</string>
    <!-- As receive_key_checking, where the brand doesn't name mints. -->
    <string name="receive_key_checking_unnamed">Checking your mint…</string>
    <string name="receive_invoice_key_changed_unnamed">The signing key of your mint doesn\'t match the one your wallet knows, so no invoice can be created right now.</string>

    <string name="receive_address_mint_silent">%1$s isn\'t answering, so payments to this address can\'t arrive right now.</string>
    <string name="receive_invoice_mint_silent">%1$s isn\'t answering, so no invoice can be created right now. Try again later.</string>
    <string name="receive_title">Receive</string>
    <string name="receive_copy">Copy</string>
    <string name="receive_share">Share</string>
    <string name="receive_copied">Address copied</string>
    <string name="receive_request_amount">Request a specific amount</string>
    <string name="receive_other_address">Show another address</string>
    <string name="receive_use_address">Show a Lightning address</string>
    <string name="receive_invoice_intro">Create a Lightning invoice for the amount you want. It can be paid from any Lightning wallet, once.</string>
    <string name="receive_invoice_create">Create invoice</string>
    <string name="receive_invoice_range">Choose an amount from %1$s to %2$s.</string>
    <string name="receive_invoice_offline">You\'re offline. Connect to create an invoice.</string>
    <string name="receive_invoice_refused">No invoice could be created. Try again later.</string>
    <string name="receive_invoice_qr">Lightning invoice</string>
    <string name="receive_invoice_fee">You receive %1$s after a fee of %2$s.</string>
    <string name="receive_invoice_waiting">Waiting for payment…</string>
    <string name="receive_invoice_copied">Invoice copied</string>
    <string name="receive_invoice_other_amount">Other amount</string>
    <string name="receive_invoice_expired">This invoice expired without being paid.</string>
    <string name="receive_invoice_new">New invoice</string>
    <string name="receive_done">Done</string>
    <string name="receive_success_title">Payment received</string>
    <string name="receive_more">Receive more</string>
    <!-- Developer mode on a local regtest mint (debug builds): dev/regtest's faucet pays this wallet. %1$s: an amount -->
    <string name="receive_faucet_address">Developer: get %1$s from regtest</string>
    <string name="receive_faucet_invoice">Developer: pay this invoice from regtest</string>
    <!-- %1$s: the faucet's or the connection's error, as it came -->
    <string name="receive_faucet_failed">The regtest faucet didn\'t pay: %1$s. Is dev/regtest up and connected?</string>
    <!-- Which mint the money is received on, with a way to pick another (%1$s: the mint) -->
    <string name="receive_on">On %1$s</string>
    <string name="receive_on_title">Receive on</string>
    <!-- A mint in that list where the account has no Lightning address -->
    <string name="receive_on_invoice">With an invoice for an amount</string>
    <!-- A mint in that list whose signing key doesn't match: it can't be picked -->
    <string name="receive_on_key_changed">Signing key doesn\'t match</string>
    <!-- Under the Lightning address, instead of receive_hint, when its mint's signing key doesn't match. %1$s: the mint. -->
    <string name="receive_address_key_changed">The signing key of %1$s doesn\'t match the one your wallet knows. Payments to this address wait there until it matches again, or you accept a new key in its details.</string>
    <!-- No invoice was made on that mint (%1$s): its signing key doesn't match. -->
    <string name="receive_invoice_key_changed">The signing key of %1$s doesn\'t match the one your wallet knows, so no invoice is created there until it matches again, or you accept a new key in its details.</string>
    <!-- While the mint's (%1$s) signing key is asked for, before anything is made there -->
    <string name="receive_key_checking">Checking %1$s…</string>
    <!-- Opens the mint's details, where its new signing key can be accepted -->
    <string name="receive_key_changed_action">Details</string>
</resources>
