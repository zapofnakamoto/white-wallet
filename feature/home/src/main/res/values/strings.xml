        <item quantity="one">Your mint doesn\'t know %1$d of your notes</item>
        <item quantity="other">Your mint doesn\'t know %1$d of your notes</item>
    </plurals>
    <!-- %1$s: what the notes are worth. Plural by how many notes there are. -->
    <plurals name="home_unknown_body">
        <item quantity="one">%1$s isn\'t in your balance for now. Your wallet keeps the note and asks the mint again by itself; once the mint knows it again, it\'s back.</item>
        <item quantity="other">%1$s isn\'t in your balance for now. Your wallet keeps the notes and asks the mint again by itself; once the mint knows them again, they\'re back.</item>
    </plurals>
