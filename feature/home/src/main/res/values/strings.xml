        <item quantity="one">%2$s doesn\'t know %1$d of your notes</item>
        <item quantity="other">%2$s doesn\'t know %1$d of your notes</item>
    </plurals>
    <!-- The same, where mints aren't named (brand mints.visible=false). -->
