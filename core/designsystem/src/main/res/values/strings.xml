<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Brand terms: the strings in this block name the party that holds users' funds ("mint" by default) or the notes
      it issues ("note"). A brand that uses other words overrides exactly these, per language, in
      brand/res/values*/strings.xml. All other strings are written without either word. See docs/WHITE_LABEL.md.
    -->
    <!-- What's new in the release that dropped the older key derivation (LUD-26 draft 2f17578); shown once to users who updated. -->
    <string name="release_note_old_keys_title">Notes from before version 0.8</string>
    <string name="release_note_old_keys_body">This version no longer finds notes and Lightning addresses made the way the app made them before version 0.8. Since then, the app moved them over by itself whenever it was opened. If money is missing, open your recovery phrase once in version 0.9.0, which still moves them, then use “Scan for notes” here.</string>
    <!-- Why a note received as a link wasn't claimed (see received_title below). -->
    <string name="received_key_changed">The signing key of its mint doesn\'t match the one your wallet knows. Claimed once it matches again, or you accept the new key in the mint\'s details.</string>
    <!-- A handed-out note whose mint doesn't know it, which the user asked to take back (its page, and its own link opened). -->
    <string name="note_take_back_when_known">Its mint doesn\'t know this note right now. Your wallet claims it as soon as the mint knows it again.</string>
    <!-- %1$s: the mint's own words, in whatever language it writes. -->
    <string name="mint_message">Message from the mint: “%1$s”</string>
    <string name="received_refused">Its mint kept refusing it, so your wallet stopped trying.</string>
    <plurals name="received_refused_hours">
        <item quantity="one">Its mint kept refusing it for %d hour, so your wallet stopped trying.</item>
        <item quantity="other">Its mint kept refusing it for %d hours, so your wallet stopped trying.</item>
    </plurals>
    <plurals name="received_refused_days">
        <item quantity="one">Its mint kept refusing it for %d day, so your wallet stopped trying.</item>
        <item quantity="other">Its mint kept refusing it for %d days, so your wallet stopped trying.</item>
    </plurals>
    <plurals name="received_unreachable_hours">
        <item quantity="one">Its mint didn\'t answer for %d hour, so your wallet stopped trying.</item>
        <item quantity="other">Its mint didn\'t answer for %d hours, so your wallet stopped trying.</item>
    </plurals>
    <plurals name="received_unreachable_days">
        <item quantity="one">Its mint didn\'t answer for %d day, so your wallet stopped trying.</item>
        <item quantity="other">Its mint didn\'t answer for %d days, so your wallet stopped trying.</item>
    </plurals>
    <string name="received_unreachable">Its mint didn\'t answer, so your wallet stopped trying.</string>
    <!-- A received note waits for its mint, which didn't answer the last time (mints not named). -->
    <string name="received_waiting_mint_unnamed">Claimed when its mint answers.</string>
    <string name="received_lightning_no_key">Its mint publishes no signing key, so it can only be received over Lightning, for a fee.</string>
    <string name="received_lightning_not_a_note">Its mint doesn\'t answer for it as a note, so it can only be received over Lightning, for a fee.</string>
    <!-- A mint's signing key doesn't match the pinned one (KeyChangedCard) -->
    <string name="mint_key_changed">The signing key of %1$s doesn\'t match the one your wallet knows. Nothing is sent there and no invoice is created until it matches again, or you accept the new key. Payments to your addresses there wait until then.</string>
    <!-- The same where one thing failed on that mint (a payment, a note, claiming one handed out): nothing else waits there. -->
    <string name="mint_key_changed_nothing_sent">The signing key of the mint doesn\'t match the one your wallet knows. Until it matches again, or you accept the new key in the mint\'s details, nothing is sent there.</string>
    <string name="mint_not_answering_unnamed">Your mint isn\'t answering. Try again later.</string>
    <string name="own_claim_refused">Its mint didn\'t accept that. Try again later.</string>
    <string name="mint_key_accept_body">Only do this if you know why %1$s changed its key, for example because its operator announced it. If someone else is answering in its place, your notes there and anything you send can be lost.</string>

    <!-- How a take back, or anything asked of a mint, ended: shared by every screen that ends one. -->
    <string name="take_back_done_title">Claimed</string>
    <string name="take_back_failed">Not claimed</string>
    <string name="no_answer_title">No answer yet</string>
    <!-- Under no_answer_title, wherever the wallet asks the mint again by itself. -->
    <string name="no_answer_hint">Your wallet asks again on the next refresh. History shows when it\'s done.</string>
    <!-- The same for claiming one's own note: its History row already says so, so it isn't pointed at. -->
    <string name="own_claim_no_answer_hint">Your wallet asks again on the next refresh.</string>
    <!-- Under take_back_done_title: the user's own handed-out note, claimed by the user. -->
    <string name="own_claim_done">You can spend it again.</string>
    <!-- The user's own handed-out note, which someone claimed before the user did. -->
    <string name="own_claim_too_late">Too late: someone already claimed it.</string>
    <!-- Why something asked of a mint didn't happen: the phone couldn't reach it. -->
    <string name="couldnt_connect">Couldn\'t connect. Try again later.</string>
    <string name="mint_not_answering">%1$s isn\'t answering. Try again later.</string>
    <!-- One or more mints (%2$s, joined for the language, "a.com and b.com"); %1$d: how many. -->
    <plurals name="mints_not_answering">
        <item quantity="one">%2$s isn\'t answering. Try again later.</item>
        <item quantity="other">%2$s aren\'t answering. Try again later.</item>
    </plurals>

